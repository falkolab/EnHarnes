{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/upstream-sync-due.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/validate-bash.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/validate-edit.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/post-edit-lint.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/post-bash-main-clean.py\""
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/log-agent-usage.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/prompt-validator.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v python3 || command -v python) \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/post-response-sync.py\""
          }
        ]
      }
    ]
  }
}
